# 魔搭（ModelScope）API
# 到 https://modelscope.cn/my/myaccesstoken 获取 token
MODELSCOPE_API_KEY=your_modelscope_token_here

# LLM 端点与模型（OpenAI 兼容）
# 换成本地 vLLM 时改这两行即可，例如：
#   LLM_BASE_URL=http://localhost:8000/v1
#   LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# 密钥所在的环境变量名（默认 MODELSCOPE_API_KEY）
LLM_API_KEY_ENV=MODELSCOPE_API_KEY

# Neo4j数据库配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=all-in-rag
NEO4J_DATABASE=neo4j

# Milvus向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 模型配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 检索条数
TOP_K=5

# 日志级别
LOG_LEVEL=INFO
