# 魔搭（ModelScope）API
# 到 https://modelscope.cn/my/myaccesstoken 获取 token
MODELSCOPE_API_KEY=your_modelscope_token_here

# LLM 端点与模型（OpenAI 兼容）
# 换成本地 vLLM 时改这两行即可，例如：
#   LLM_BASE_URL=http://localhost:8000/v1
#   LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
#
# 请先在 https://modelscope.cn 确认目标模型可用，或沿用下面这个。
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL=Qwen/Qwen3.8-Flash-Next

# 密钥所在的环境变量名（默认 MODELSCOPE_API_KEY）
LLM_API_KEY_ENV=MODELSCOPE_API_KEY

# Neo4j数据库配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=all-in-rag
NEO4J_DATABASE=neo4j

# Milvus向量数据库配置
# 两种模式二选一：
#   1) Milvus Lite（嵌入式，无需 Docker，适合本地/小数据量）
#        MILVUS_LITE_PATH=./milvus_data.db
#   2) 独立 Milvus 服务（需 docker run / compose 启动）
#        MILVUS_LITE_PATH=            <- 留空即按下面 host/port 连
#        MILVUS_HOST=localhost
#        MILVUS_PORT=19530
#

MILVUS_LITE_PATH=./milvus_data.db
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 模型配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 嵌入模型运行设备：cpu / cuda / cuda:0
# 有 NVIDIA GPU 且 torch 带 CUDA 时设 cuda，检索可快 10 倍以上；
# 若设了 cuda 但环境不可用，程序会自动降级为 cpu 并打 warning。
EMBEDDING_DEVICE=cpu

# 检索条数
TOP_K=5

# 日志级别
LOG_LEVEL=INFO
